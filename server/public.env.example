# Load using: node --env-file=server/public.env server/supervise.mjs
# Copy to server/public.env (Git-ignored). Do not enable until local setup/MFA is complete.
RIVERROOM_MODE=public
RIVERROOM_PUBLIC_ORIGIN=https://poker.your-domain.example
RIVERROOM_ACCESS_TEAM=https://your-team.cloudflareaccess.com
# Exact 64-character application AUD tag from your private Cloudflare Access application.
RIVERROOM_ACCESS_AUD=REPLACE_WITH_APPLICATION_AUD
PORT=3000
